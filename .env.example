# Banco de dados (obrigatório em produção)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"

# Segredo para assinatura das sessões (obrigatório - gere com: openssl rand -base64 32)
AUTH_SECRET=""

# Credenciais do primeiro administrador (usadas no seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Vercel Blob (obrigatório em produção - adicionado automaticamente no painel Vercel)
BLOB_READ_WRITE_TOKEN=""