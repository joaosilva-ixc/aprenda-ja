generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VideoStatus {
  UPLOADING
  READY
  SYNCING
  SYNCED
  FAILED
}

enum UserRole {
  ADMIN
  ALUNO
}

model Theme {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  icon      String
  color     String
  createdAt DateTime @default(now())
  aulas     Aula[]
}

model Aula {
  id           String      @id @default(cuid())
  title        String
  description  String
  themeId      String
  theme        Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  videoUrl     String
  blobPathname String?     @unique
  durationSec  Int?
  status       VideoStatus @default(READY)
  tags         String[]
  viewCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  progress     AulaProgress[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ALUNO)
  lastAccessAt DateTime?
  mustChangePassword Boolean @default(false)
  streakCount  Int      @default(0)
  lastStudyDate DateTime?
  progress     AulaProgress[]
  createdAt    DateTime @default(now())
}

model AulaProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aulaId        String
  aula          Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  completed     Boolean  @default(false)
  favorite      Boolean  @default(false)
  lastAccessedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, aulaId])
}

model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}
