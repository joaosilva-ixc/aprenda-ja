generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ThemeSlug {
  CONFIGURACAO_GERAL
  USABILIDADE
  PABX
  FLUXO_COMUNICACAO
}

enum VideoStatus {
  UPLOADING
  READY
  SYNCING
  SYNCED
  FAILED
}

enum UserRole {
  ADMIN
  ALUNO
}

model Theme {
  id        String    @id @default(cuid())
  slug      ThemeSlug @unique
  name      String
  icon      String
  color     String
  createdAt DateTime  @default(now())
  aulas     Aula[]
}

model Aula {
  id           String      @id @default(cuid())
  title        String
  description  String
  themeId      String
  theme        Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  videoUrl     String
  blobPathname String?     @unique
  durationSec  Int?
  status       VideoStatus @default(READY)
  tags         String[]
  viewCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ALUNO)
  lastAccessAt DateTime?
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
}
